# StrawHub — Firebase configuration
# Copy to `.env.local` and fill in your own project values.
# Expo inlines EXPO_PUBLIC_* variables at build time.

# 1) Firebase Console → Project settings → Your apps → Web app → SDK setup
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 2) Google OAuth Web client ID — the same client that Firebase's Google
#    provider uses (Firebase Console → Authentication → Sign-in method →
#    Google → Web SDK configuration).
#    In Google Cloud Console → Credentials → this Web client, add the
#    redirect URIs that `useIdTokenAuthRequest` actually uses:
#      Web (Expo Go / dev):  http://localhost:8081
#      Expo Go:              exp://127.0.0.1:8081/--/ (or your LAN IP)
#    (The deprecated auth.expo.io proxy is NOT used — the app calls
#     WebBrowser.maybeCompleteAuthSession() itself on return.)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 3) Optional — native client IDs for development/production builds later.
#    Expo Go does not need these.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# 4) Optional — Firebase web app measurement ID (Google Analytics).
#    Found under Project settings → Your apps → Web app → SDK setup.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=